PORT=5500
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
TEST_DATABASE_URL=postgres://user:password@host/test_dbname?sslmode=require
CRON_SECRET=
JWT_SECRET=change_this_to_a_secure_random_secret_that_is_at_least_64_characters_long_for_production
BCRYPT_ROUNDS=12
NODE_ENV=development
ALLOWED_ORIGIN=*
HISTORY_RETENTION_DAYS=45
OUTLET_TIMEZONE=Asia/Kolkata
# Backup storage driver: local (dev only), s3, gcs, or provider-managed (production)
BACKUP_STORAGE_DRIVER=local
